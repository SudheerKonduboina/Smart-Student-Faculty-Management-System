# ==============================================================================
# Git Ignore - Smart Student & Faculty Management System
# ==============================================================================

# Compiled Java / Maven artifacts
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar

# Node / Frontend build & dependencies
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python environments, cache, and bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
venv/
**/venv/
env/
**/env/
ENV/
*.egg-info/
.pytest_cache/

# Large database archives & portable database installations
mysql.zip
mariadb.zip
*.zip
*.tar.gz
*.7z
*.rar
mysql_portable/
mariadb/

# Runtime user uploads (keep empty directory via .gitkeep)
uploads/*
!uploads/.gitkeep

# IDE, Editors & OS Files
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
**/logs/

# Temporary / testing directory
frontend_noamp/
